/*
 * Copy this file to `secrets.h` (same folder) and fill in your values.
 * `secrets.h` is git-ignored so your Wi-Fi credentials never get committed.
 */
#pragma once

// ---- Wi-Fi ----
#define WIFI_SSID      "Your_WiFi_SSID"
#define WIFI_PASSWORD  "Your_WiFi_Password"

// ---- Backend ----
// The /api/ingest endpoint of your self-hosted backend (LAN IP of the host
// running the Node backend, port 4000 by default).
#define BACKEND_INGEST_URL  "http://192.168.1.50:4000/api/ingest"

// ---- Optional: ingest auth ----
// Uncomment AND set the same value as INGEST_KEY in the backend's .env to
// require the node to authenticate.
// #define INGEST_KEY  "change-me"

// ---- Optional: OTA password ----
// #define OTA_PASSWORD  "ota-secret"

// ---- Optional: static IP ----
// Uncomment USE_STATIC_IP and set the four addresses to give the node a
// fixed LAN IP. Otherwise it uses DHCP (recommended — the node pushes out,
// so it doesn't need a known IP).
// #define USE_STATIC_IP
// #define STATIC_IP       "192.168.1.120"
// #define STATIC_GATEWAY  "192.168.1.1"
// #define STATIC_SUBNET   "255.255.255.0"
