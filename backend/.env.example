# Copy to .env and adjust for your LAN host.

# HTTP port the API + WebSocket listen on
PORT=4000

# Bind address. 0.0.0.0 exposes the API to the whole LAN (needed so the
# ESP32-S3 node and phones/browsers on the network can reach it).
HOST=0.0.0.0

# SQLite database file location (created automatically).
DB_PATH=./data/water.db

# Shared secret the ESP32-S3 node must send in the `x-ingest-key` header
# on POST /api/ingest. Leave blank to disable auth (LAN-only, trusted).
INGEST_KEY=

# A node is considered OFFLINE if no reading arrived within this many
# seconds. Set to ~3x the firmware's reporting interval.
OFFLINE_TIMEOUT_SECONDS=90

# How long to retain raw readings (days). Older rows are pruned on startup
# and daily. 0 = keep forever.
HISTORY_RETENTION_DAYS=90
